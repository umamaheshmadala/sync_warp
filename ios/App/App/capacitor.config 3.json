{
	"appId": "com.maheshsyncapp.mobile",
	"appName": "Sync App",
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resize": "ionic",
			"resizeOnFullScreen": true
		},
		"SplashScreen": {
			"launchShowDuration": 3000,
			"showSpinner": false,
			"launchAutoHide": true,
			"backgroundColor": "#ffffffff",
			"androidScaleType": "CENTER_INSIDE",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"overlay": true,
			"style": "LIGHT",
			"backgroundColor": "#ffffffff"
		},
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"packageClassList": [
		"ContactsPlugin",
		"ActionSheetPlugin",
		"AppPlugin",
		"CAPCameraPlugin",
		"DialogPlugin",
		"FilesystemPlugin",
		"GeolocationPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"PushNotificationsPlugin",
		"ScreenOrientationPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"TextZoomPlugin",
		"FilePickerPlugin",
		"VideoEditorPlugin"
	]
}
